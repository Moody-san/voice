# App
PORT=3000
APP_ENV=development

# Postgres (Docker, see docker-compose.yml — host port 5434)
DB_HOST=localhost
DB_PORT=5434
DB_USERNAME=voice
DB_PASSWORD=voice
DB_DATABASE=voice_patients
# true for local dev (schema tracks entities); use migrations in production
DB_SYNCHRONIZE=true

# Shared secret Vapi must send as the x-vapi-secret header on every
# tool call / webhook. Set the SAME value in the Vapi dashboard.
VAPI_SECRET=replace-with-a-long-random-string

# Public URL the backend is reachable at (your ngrok static domain)
PUBLIC_URL=https://your-domain.ngrok-free.dev
